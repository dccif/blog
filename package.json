{
  "name": "dccif-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json && node ./node_modules/typescript-native/bin/tsc --noEmit",
    "build": "astro build && node scripts/legacy-redirects.mjs && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && node ./node_modules/typescript-native/bin/tsc --noEmit",
    "new-post": "node scripts/new-post.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "verify": "node scripts/verify-build.mjs",
    "migrate:hexo": "node scripts/migrate-hexo.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@expressive-code/core": "^0.44.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.96",
    "@iconify/svelte": "^5.2.3",
    "@swup/astro": "^1.8.0",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "hastscript": "^9.0.1",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.17.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "stylus": "^0.64.0",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  }
}
